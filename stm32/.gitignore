*.elf
*.bin
*.hex
*.uf2
*.map

# Probe/debug logs and dumps
*.log
*.dmp

# Editor/IDE
.vscode/
.idea/

# Vim/Neovim
*.swp
*.swo
*.swn
*.un~
Session.vim
Sessionx.vim

# OS files
.DS_Store
Thumbs.db
